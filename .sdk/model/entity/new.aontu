# Entity: new

main: kit: entity: new: {

  alias: field: {}

  fields: [
    {
      name: "category"
      req: false
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "thumbnail"
      req: false
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      type: "`$STRING`"
    }
    {
      name: "videoUrl"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "new"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/breaking-news.json"
          parts: [
            "breaking-news.json"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.articles`"
          }
        }
      ]
    }
  }



}

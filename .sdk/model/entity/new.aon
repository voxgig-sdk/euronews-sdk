# Entity: new

main: kit: entity: new: {

  alias: field: {}

  fields: [
    {
      name: "category"
      req: false
      short: "Category of the news (e.g., economy, politics, diplomacy)"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Brief description or summary of the article"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the news article"
      type: "`$STRING`"
    }
    {
      name: "publishedAt"
      req: false
      short: "Publication date and time"
      type: "`$STRING`"
    }
    {
      name: "thumbnail"
      req: false
      short: "Thumbnail image URL"
      type: "`$STRING`"
    }
    {
      name: "title"
      req: false
      short: "Title of the news article"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "URL to the full article"
      type: "`$STRING`"
    }
    {
      name: "videoUrl"
      req: false
      short: "URL to video content if available"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "new"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/breaking-news.json"
          parts: [
            "breaking-news.json"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.articles`"
          }
        }
      ]
    }
  }



}
